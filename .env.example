# Copy to .env and fill in
SARVAM_API_KEY=your-sarvam-subscription-key

# Speech provider: sarvam | elevenlabs | smallest
SPEECH_PROVIDER=sarvam
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Smallest.ai Waves TTS (SPEECH_PROVIDER=smallest)
SMALLEST_API_KEY=
SMALLEST_VOICE_ID=jessica
SMALLEST_SAMPLE_RATE=24000

# LLM provider: openai | deepseek | realtime
# realtime = gpt-4o-mini-realtime-preview (handles STT+LLM+TTS in one WebSocket)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI Realtime settings (LLM_PROVIDER=realtime)
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
REALTIME_VOICE=alloy

# Interview config
AGENT_NAME=Sarah
INTERVIEW_DURATION_MIN=20

# Turn-taking tuning (milliseconds of silence that ends a user turn)
ENDPOINT_SILENCE_MS=1000

# Session cookie (server-side session, no SSO yet — staff identity/passwords
# now live in Supabase Auth, this just signs the session cookie)
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_MAX_AGE_DAYS=14
SESSION_HTTPS_ONLY=false

# Supabase — Project Settings > API for the first three, Project Settings >
# Database > Connection string (Transaction pooler mode) for DATABASE_URL.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# First-run admin account, seeded once if staff_profiles is empty.
# After first run, add more accounts via /team (requires an existing admin).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
ADMIN_TEAM=technical
