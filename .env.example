# Copy to .env and fill in
SARVAM_API_KEY=your-sarvam-subscription-key

# Speech provider: sarvam or elevenlabs
SPEECH_PROVIDER=sarvam
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# LLM provider: openai or deepseek
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Interview config
AGENT_NAME=Sarah
INTERVIEW_ROLE=Backend Software Engineer
INTERVIEW_TOPICS=REST API design, databases and indexing, caching, system design basics
INTERVIEW_DURATION_MIN=20

# Turn-taking tuning (milliseconds of silence that ends a user turn)
ENDPOINT_SILENCE_MS=650
