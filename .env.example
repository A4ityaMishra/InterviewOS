# Copy to .env and fill in
SARVAM_API_KEY=your-sarvam-subscription-key

# Speech provider: sarvam | elevenlabs | smallest
SPEECH_PROVIDER=sarvam
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Smallest.ai Waves TTS (SPEECH_PROVIDER=smallest)
SMALLEST_API_KEY=
SMALLEST_VOICE_ID=jessica
SMALLEST_SAMPLE_RATE=24000

# LLM provider: openai | deepseek | realtime
# realtime = gpt-4o-mini-realtime-preview (handles STT+LLM+TTS in one WebSocket)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# OpenAI Realtime settings (LLM_PROVIDER=realtime)
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
REALTIME_VOICE=alloy

# Interview config
AGENT_NAME=Sarah
INTERVIEW_ROLE=Backend Software Engineer
INTERVIEW_TOPICS=REST API design, databases and indexing, caching, system design basics
INTERVIEW_DURATION_MIN=20

# Turn-taking tuning (milliseconds of silence that ends a user turn)
ENDPOINT_SILENCE_MS=650
